# Copy to .env and export the variables before starting the server.
# .env is gitignored. Never commit a real key.
DATABASE_PATH=./data/campustrace.sqlite3
CACHE_TTL_SECONDS=86400
REQUEST_TIMEOUT_SECONDS=8
# Server-side budget for one profile build, in seconds. The case allows 30 s
# from submit to a useful result; the rest is left for transfer and rendering.
PROFILE_BUDGET_SECONDS=24

# --- Required-ish: identify yourself to the public Wikimedia/OSM APIs ---
# Nominatim refuses to run without a real contact address here.
CAMPUS_TRACE_USER_AGENT='CampusTraceHackathon/0.6 (contact: your-email@example.com)'

# --- Independent visual classification (xAI Grok) -----------------------
# Second, independent opinion on what each licensed candidate photo shows.
# Without it the pipeline still works and honestly reports that the visual
# check was not performed; categories then rest on Commons text alone.
GROK_API_KEY=
GROK_VISION_MODEL=grok-2-vision-1212
GROK_VISION_MAX_IMAGES=24
GROK_TIMEOUT_SECONDS=12

# --- Maps ---------------------------------------------------------------
# The basemap is MapLibre GL + OpenFreeMap and needs NO key: that is the
# deliberate default so the demo cannot fail on a quota during judging.
# Mapbox is optional and used only as (a) a second geocoder to cross-check
# the campus coordinate and (b) an alternative isochrone provider.
MAPBOX_TOKEN=
OPENROUTESERVICE_API_KEY=

# --- Optional discovery/enrichment. Core search works without all of these ---
BRAVE_API_KEY=
FLICKR_API_KEY=
YOUTUBE_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OFFICIAL_YOUTUBE_CHANNELS_JSON={}
