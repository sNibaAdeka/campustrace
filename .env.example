# Copy to .env and export variables before starting the server.
DATABASE_PATH=./data/campustrace.sqlite3
CACHE_TTL_SECONDS=86400
REQUEST_TIMEOUT_SECONDS=8
# Optional discovery/enrichment integrations. Core search works without these.
BRAVE_API_KEY=
FLICKR_API_KEY=
OPENROUTESERVICE_API_KEY=
YOUTUBE_API_KEY=
GROQ_API_KEY=
OFFICIAL_YOUTUBE_CHANNELS_JSON={}
CAMPUS_TRACE_USER_AGENT='CampusTraceHackathon/0.3 (contact: your-email@example.com)'
